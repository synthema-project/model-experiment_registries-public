pipeline {
    agent { label 'jenkins-dev' }

    options {
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
    }

    parameters {
        string(name: 'KUBE_CREDENTIALS_ID', defaultValue: 'k8s-admin', description: 'Jenkins Kubernetes credentials')
    }

    environment {
        // Keep aligned with the namespace and resource names in the manifest.
        NAMESPACE = 'synthema-dev'
        MANIFEST = 'k8/deployment.yaml'
        DEPLOYMENT = 'model-experiment-registry-deployment'
        SERVICE = 'model-experiment-registry-service'
    }

    stages {
        stage('Validate') {
            steps {
                withKubeConfig([credentialsId: params.KUBE_CREDENTIALS_ID]) {
                    sh '''
                        set -eu
                        kubectl get namespace "$NAMESPACE" -o name
                        kubectl -n "$NAMESPACE" apply --dry-run=server -f k8/configmap.yml -f k8/mlflow-secret.yaml
                        kubectl -n "$NAMESPACE" apply --dry-run=server -f "$MANIFEST"
                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
                withKubeConfig([credentialsId: params.KUBE_CREDENTIALS_ID]) {
                    sh '''
                        set -eu
                        kubectl -n "$NAMESPACE" apply -f k8/configmap.yml -f k8/mlflow-secret.yaml
                        kubectl -n "$NAMESPACE" apply -f "$MANIFEST"
                        kubectl -n "$NAMESPACE" rollout restart deployment/"$DEPLOYMENT"
                        kubectl -n "$NAMESPACE" rollout status deployment/"$DEPLOYMENT" --timeout=600s
                    '''
                }
            }
        }
        stage('Functional tests') {
            steps {
                withKubeConfig([credentialsId: params.KUBE_CREDENTIALS_ID]) {
                    sh 'bash tests/func_tests.sh'
                }
            }
        }
    }
}

pipeline {
    agent { label 'jenkins-dev' }

    options {
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
    }

    parameters {
        string(name: 'KUBE_CREDENTIALS_ID', defaultValue: 'k8s-admin', description: 'Jenkins Kubernetes credentials')
        string(name: 'POSTGRES_USER', defaultValue: '', description: 'PostgreSQL user for the mlflow database', trim: true)
        password(name: 'POSTGRES_PASSWORD', defaultValue: '', description: 'PostgreSQL password')
        string(name: 'AWS_ACCESS_KEY_ID', defaultValue: '', description: 'MinIO access key ID', trim: true)
        password(name: 'AWS_SECRET_ACCESS_KEY', defaultValue: '', description: 'MinIO secret access key')
    }

    environment {
        // Keep aligned with the namespace and resource names in the manifest.
        NAMESPACE = 'synthema-dev'
        MANIFEST = 'k8/deployment.yaml'
        DEPLOYMENT = 'model-experiment-registry-deployment'
        SERVICE = 'model-experiment-registry-service'
    }

    stages {
        stage('Validate') {
            steps {
                withKubeConfig([credentialsId: params.KUBE_CREDENTIALS_ID]) {
                    sh '''
                        set -eu
                        kubectl get namespace "$NAMESPACE" -o name
                        bash jenkins/mlflow-secret.sh validate
                        kubectl -n "$NAMESPACE" apply --dry-run=server -f k8/configmap.yml -f k8/mlflow-secret.yaml
                        kubectl -n "$NAMESPACE" apply --dry-run=server -f "$MANIFEST"
                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
                withKubeConfig([credentialsId: params.KUBE_CREDENTIALS_ID]) {
                    sh '''
                        set -eu
                        bash jenkins/mlflow-secret.sh apply
                        kubectl -n "$NAMESPACE" apply -f k8/configmap.yml -f k8/mlflow-secret.yaml
                        kubectl -n "$NAMESPACE" apply -f "$MANIFEST"
                        kubectl -n "$NAMESPACE" rollout restart deployment/"$DEPLOYMENT"
                        kubectl -n "$NAMESPACE" rollout status deployment/"$DEPLOYMENT" --timeout=600s
                    '''
                }
            }
            post {
                unsuccessful {
                    withKubeConfig([credentialsId: params.KUBE_CREDENTIALS_ID]) {
                        sh '''
                            # Best-effort diagnostics; preserve the original deployment failure.
                            set +e
                            kubectl --request-timeout=15s -n "$NAMESPACE" get pods -l app=mlflow -o wide
                            pods=$(kubectl --request-timeout=15s -n "$NAMESPACE" get pods -l app=mlflow -o name)
                            for pod in $pods; do
                                echo "=== $pod: init-container status ==="
                                kubectl --request-timeout=15s -n "$NAMESPACE" get "$pod" \
                                    -o jsonpath='{.status.initContainerStatuses}'
                                echo
                                echo "=== $pod: previous init-mlflow logs ==="
                                kubectl --request-timeout=15s -n "$NAMESPACE" logs "$pod" \
                                    -c init-mlflow --previous --tail=150 --timestamps
                                echo "=== $pod: current init-mlflow logs ==="
                                kubectl --request-timeout=15s -n "$NAMESPACE" logs "$pod" \
                                    -c init-mlflow --tail=150 --timestamps
                                echo "=== $pod: events ==="
                                kubectl --request-timeout=15s -n "$NAMESPACE" get events \
                                    --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod#pod/}" \
                                    --sort-by=.metadata.creationTimestamp
                            done
                            exit 0
                        '''
                    }
                }
            }
        }
        stage('Functional tests') {
            steps {
                withKubeConfig([credentialsId: params.KUBE_CREDENTIALS_ID]) {
                    sh 'bash tests/func_tests.sh'
                }
            }
        }
    }
}
